# Proměnné vstřikované do kontejnerů přes `env_file` v docker-compose.yml.
#
# Commitovaný je záměrně — neobsahuje žádné tajemství, jen hostnames platné
# uvnitř compose sítě a lokální vývojové přihlašovací údaje. Laravelí `.env`
# vznikne až v Tasku 1 a ten commitovaný nebude.
#
# Uvnitř kontejneru je Postgres na `postgres:5432`, ne na hostitelském 5433.

APP_ENV=local
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=forx
DB_USERNAME=forx
DB_PASSWORD=forx

# Testová sada běží proti vlastní databázi, kterou zakládá
# .docker/postgres/init/01-create-testing-db.sh
DB_TESTING_DATABASE=forx_testing

# V plánu 1 jedou locky i fronty nad `database` storem — Redis přijde s podprojektem 4.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Sdílený volume namontovaný do app, worker i research.
MARKET_DATA_SHARED_PATH=/shared
